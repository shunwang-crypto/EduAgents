OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# 模型名支持逗号分隔的多模型 fallback 链：主模型失败/限流（429）时自动切换下一个。
# 例（OpenCode Zen 免费模型，实测 2026-08-09 可用）：
# OPENAI_MODEL=nemotron-3-ultra-free,laguna-s-2.1-free,ling-3.0-tiny-free
OPENAI_MODEL=deepseek-chat
TAVILY_API_KEY=

# 星辰平台（对话问答工作流专用，OpenAI 兼容接口）
# 配置后对话问答优先走星辰平台；留空时自动回落 OPENAI_* 配置。
# 兼容别名：也可使用 OPENCODE_ZEN_BASE_URL / OPENCODE_ZEN_API_KEY / OPENCODE_ZEN_MODEL。
XINGCHEN_API_KEY=
XINGCHEN_BASE_URL=
XINGCHEN_MODEL=

# 对话问答演示模式：true=强制演示（不调模型，用知识库原文模拟讲解）；
# false=强制真实模型；留空=自动（未配置任何模型 API key 时自动进入演示模式）。
KB_QA_MOCK=
