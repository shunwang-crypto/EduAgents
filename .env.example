# LLM
# 重要：get_llm()（学习计划 Plan 使用）优先解析 OPENAI_*；get_kb_llm()（对话 Chat / Lesson 使用）
# 优先解析 XINGCHEN_* / OPENCODE_ZEN_*。若 OPENAI_* 与 XINGCHEN_* 同时有值，Plan 与
# Chat/Lesson 会「静默使用不同 provider」。所以默认这里留空，避免 cp .env.example .env 后
# 只补 OPENCODE_ZEN_* 却让 Plan 落到下面的第三方 base_url。
#
# 使用 OpenCode Zen（星辰平台）时：必须把 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL 全部清空，
# 否则 Plan 仍会走 OPENAI_* 而非 Zen。
OPENAI_API_KEY=
# 默认留空（不指向任何第三方）。如需 OpenAI 兼容端点再填。
OPENAI_BASE_URL=
# 模型名支持逗号分隔的多模型 fallback 链；使用 Zen 时必须留空
OPENAI_MODEL=
TAVILY_API_KEY=

# 星辰平台（OpenCode Zen，OpenAI 兼容），兼容别名 OPENCODE_ZEN_*
# 填法示例：
#   XINGCHEN_API_KEY=你的 Zen Key
#   XINGCHEN_BASE_URL=https://opencode.ai/v1
#   XINGCHEN_MODEL=nemotron-3-ultra-free   # 免费模型之一
# Zen 免费模型（XINGCHEN_MODEL 可选）：nemotron-3-ultra-free / deepseek-v4-flash-free / north-mini-code-free
# 注意：启用 Zen 前务必先清空上面的 OPENAI_API_KEY / OPENAI_BASE_URL / OPENAI_MODEL。
XINGCHEN_API_KEY=
XINGCHEN_BASE_URL=
XINGCHEN_MODEL=

# ---------------------------------------------------------------------------
# 本地 Dynamic Learner Model（SQLite，唯一画像真值）
# ---------------------------------------------------------------------------
LEARNER_MODEL_DB_PATH=
LEARNER_MODEL_AUTO_UPDATE=true
# 开发期默认用户（默认空=必须由 X-User-Id 头提供；本地开发可显式配置）
LEARNER_MODEL_USER_ID=STU-001

# CORS：逗号分隔允许的 origin（开发默认本地 Vite）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# 前端（开发）
# ---------------------------------------------------------------------------
# VITE_DEV_USER_ID=STU-001
