OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# 模型名支持逗号分隔的多模型 fallback 链：主模型失败/限流（429）时自动切换下一个。
OPENAI_MODEL=deepseek-chat
TAVILY_API_KEY=

# 星辰平台（对话问答工作流专用，OpenAI 兼容接口）
# 兼容别名：也可使用 OPENCODE_ZEN_BASE_URL / OPENCODE_ZEN_API_KEY / OPENCODE_ZEN_MODEL。
XINGCHEN_API_KEY=
XINGCHEN_BASE_URL=
XINGCHEN_MODEL=

# 对话问答演示模式：true=强制演示（不调模型，用知识库原文模拟讲解）；
# false=强制真实模型；留空=自动（未配置任何模型 API key 时自动进入演示模式）。
KB_QA_MOCK=

# ---------------------------------------------------------------------------
# LearnerState Provider（外部学习者画像，EduAgents 只读消费，不维护第二套画像）
# ---------------------------------------------------------------------------
# provider: mock | remote | auto（默认 auto：配置了 base_url 走 remote，否则 mock）
LEARNER_STATE_PROVIDER=auto
LEARNER_STATE_BASE_URL=
LEARNER_STATE_API_KEY=
LEARNER_STATE_TIMEOUT_SECONDS=8
LEARNER_STATE_CACHE_TTL=300
LEARNER_STATE_COURSE_ID=JAVA-OOP
LEARNER_STATE_USER_ID=STU-001

# ---------------------------------------------------------------------------
# Learning Event 回传（EduAgents 只 Emit Evidence，不改画像数值）
# ---------------------------------------------------------------------------
# delivery_enabled=true 且配置 delivery_url 后，后台投递 Outbox 中的事件。
LEARNING_EVENT_DELIVERY_ENABLED=false
LEARNING_EVENT_DELIVERY_URL=
