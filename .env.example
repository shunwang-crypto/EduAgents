# LLM
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# 模型名支持逗号分隔的多模型 fallback 链
OPENAI_MODEL=deepseek-chat
TAVILY_API_KEY=

# 星辰平台（OpenAI 兼容），兼容别名 OPENCODE_ZEN_*
XINGCHEN_API_KEY=
XINGCHEN_BASE_URL=
XINGCHEN_MODEL=

# ---------------------------------------------------------------------------
# 本地 Dynamic Learner Model（SQLite，唯一画像真值）
# ---------------------------------------------------------------------------
LEARNER_MODEL_DB_PATH=
LEARNER_MODEL_AUTO_UPDATE=true
# 开发期默认用户（默认空=必须由 X-User-Id 头提供；本地开发可显式配置）
LEARNER_MODEL_USER_ID=STU-001

# CORS：逗号分隔允许的 origin（开发默认本地 Vite）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

