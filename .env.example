OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.deepseek.com
# 模型名支持逗号分隔的多模型 fallback 链：主模型失败/限流（429）时自动切换下一个。
OPENAI_MODEL=deepseek-chat
TAVILY_API_KEY=

# 星辰平台（对话问答工作流专用，OpenAI 兼容接口）
# 兼容别名：也可使用 OPENCODE_ZEN_BASE_URL / OPENCODE_ZEN_API_KEY / OPENCODE_ZEN_MODEL。
XINGCHEN_API_KEY=
XINGCHEN_BASE_URL=
XINGCHEN_MODEL=

# 对话问答演示模式：true=强制演示（不调模型，用知识库原文模拟讲解）；
# false=强制真实模型；留空=自动（未配置任何模型 API key 时自动进入演示模式）。
KB_QA_MOCK=

# ---------------------------------------------------------------------------
# 本地 Dynamic Learner Model（SQLite，唯一画像真值；无任何外部画像服务依赖）
# ---------------------------------------------------------------------------
# 数据库路径（默认 data/learner_model.db）
LEARNER_MODEL_DB_PATH=
# 事件是否自动更新画像（true=apply_event 自动提取证据并更新；false=只记录事件）
LEARNER_MODEL_AUTO_UPDATE=true
# 每累计 N 个课程事件生成一次画像快照
LEARNER_MODEL_SNAPSHOT_INTERVAL=10
# 是否启用 LLM 语义推断（默认关；开启时 LLM 只产出 Evidence Candidate，由 Updater 决定落库）
LEARNER_MODEL_LLM_INFERENCE_ENABLED=false
# 默认用户/课程
LEARNER_MODEL_USER_ID=STU-001
LEARNER_MODEL_COURSE_ID=JAVA-OOP
