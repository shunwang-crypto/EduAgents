# LLM
# 学习计划和对话默认可使用 Google Gemini 的 OpenAI-compatible endpoint。
MODEL_ROUTING_ENABLED=false
GOOGLE_OPENAI_API_KEY=
GOOGLE_OPENAI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
GOOGLE_TEXT_MODEL=gemma-4-26b-a4b-it
GOOGLE_VISION_MODEL=gemma-4-31b-it
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=
TAVILY_API_KEY=
LLM_REQUEST_TIMEOUT_SECONDS=600

# 可选的其它 OpenAI-compatible provider（不启用 Google 路由时使用）
XINGCHEN_API_KEY=
XINGCHEN_BASE_URL=
XINGCHEN_MODEL=

# ---------------------------------------------------------------------------
# 本地 Dynamic Learner Model（SQLite，唯一画像真值）
# ---------------------------------------------------------------------------
LEARNER_MODEL_DB_PATH=
LEARNER_MODEL_AUTO_UPDATE=true
# 开发期默认用户（默认空=必须由 X-User-Id 头提供；本地开发可显式配置）
LEARNER_MODEL_USER_ID=STU-001

# CORS：逗号分隔允许的 origin（开发默认本地 Vite）
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------------------------------------------------------------------------
# 前端（开发）
# ---------------------------------------------------------------------------
# VITE_DEV_USER_ID=STU-001
